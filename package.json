{
  "name": "thinkwires",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "npm@11.7.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:system": "turbo test:system",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "npm --prefix apps/backend run migrate",
    "migrate:status": "npm --prefix apps/backend run migrate:status",
    "migrate:down": "npm --prefix apps/backend run migrate:down"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.7"
  }
}
