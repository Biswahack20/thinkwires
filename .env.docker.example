# Docker Compose local database credentials
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.docker and replace the placeholder
# password with a strong, unique password before running
# docker compose up.
#
#   cp .env.docker.example .env.docker
#
# .env.docker is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────

POSTGRES_USER=thinkwires_user
POSTGRES_PASSWORD=replace_with_a_strong_unique_password
POSTGRES_DB=thinkwire_db
