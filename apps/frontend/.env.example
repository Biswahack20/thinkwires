# ==============================================================================
# ThinkWire Frontend — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' inside 'apps/frontend/' before running the dev server:
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# All variables MUST be prefixed with VITE_ to be exposed to the browser bundle.
# Variables without this prefix are stripped at build time by Vite.
#
# DO NOT commit real API keys, tokens, or production URLs to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Gateway Connection
# ------------------------------------------------------------------------------
# Base URL of the Express.js Backend API Gateway (apps/backend).
# The frontend uses this to make all REST API calls (auth, jobs, candidates).
# Local development default — change for staging/production deployments.
VITE_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. Application Environment
# ------------------------------------------------------------------------------
# Identifies the current environment for conditional feature rendering.
# Options: 'development', 'staging', 'production'
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# 3. Application Branding & Display
# ------------------------------------------------------------------------------
# Human-readable application name shown in the browser title and meta tags.
VITE_APP_NAME=ThinkWires

# ------------------------------------------------------------------------------
# 4. Feature Flags (Optional — Frontend-Only Toggles)
# ------------------------------------------------------------------------------
# Enable verbose API request/response logging in the browser DevTools console.
# Set to 'false' in staging and production environments.
VITE_ENABLE_DEBUG_LOGGING=true

# Enable mock API responses for UI development without a running backend.
# Uses internal fixture data instead of real HTTP calls.
VITE_ENABLE_MOCK_API=false

# ------------------------------------------------------------------------------
# 5. Analytics & Monitoring (Optional — Production Only)
# ------------------------------------------------------------------------------
# PostHog project API key for user behavior and funnel analytics.
# Obtain from: https://app.posthog.com/project/api-keys
VITE_POSTHOG_KEY=phc_placeholder_key

# Sentry DSN for frontend JavaScript error tracking and performance monitoring.
# Obtain from: https://sentry.io/settings/projects/
VITE_SENTRY_DSN=https://placeholder@sentry.io/0000000
