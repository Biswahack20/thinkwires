# ==============================================================================
# ThinkWires AI Services - Environment Configuration Template
# ==============================================================================
# Location: apps/ai_services/.env
# Copy this file to '.env' inside 'apps/ai_services/' before starting:
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
# ==============================================================================

# Server network bindings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Allowed Origins (comma-separated list of trusted origins, wildcard '*' disallowed)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000

# OpenAI LLM integration
# Leave blank or use default to enable deterministic heuristic fallback mode
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
