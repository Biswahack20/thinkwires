# ==============================================================================
# ThinkWires Backend - Environment Configuration Template
# ==============================================================================
# Location: apps/backend/.env
# Copy this file to '.env' inside 'apps/backend/' before running:
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. Database Connections (Dual-Persistence Architecture)
# ------------------------------------------------------------------------------
# PostgreSQL (Sequelize) - Relational storage (Neon serverless or local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thinkwire_db

# MongoDB (Mongoose) - Unstructured documents, ATS, CMS, applications, candidates
# Local default or MongoDB Atlas cluster connection string:
MONGODB_URI=mongodb://localhost:27017/thinkwire_db

# Optional Redis Cache
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Microservice Integrations
# ------------------------------------------------------------------------------
# Python FastAPI AI Microservice URL for resume parsing, ATS scoring & assessments
AI_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens and validating candidate auth cookies
JWT_SECRET=your_secure_random_jwt_secret_here

# ------------------------------------------------------------------------------
# 5. Recruitment Email Notifications (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=careers@thinkwires.com
SMTP_PASS=your_smtp_app_password_here
SMTP_SECURE=false
EMAIL_FROM="ThinkWires Recruitment" <careers@thinkwires.com>
RECRUITMENT_NOTIFICATION_EMAIL=recruitment@thinkwires.com
RECRUITMENT_EMAIL=recruitment@thinkwires.com
ADMIN_NOTIFICATION_EMAIL=admin@thinkwires.com