# Set default behavior to automatically normalize line endings to LF on checkout and commit
* text=auto eol=lf

# Explicit text files that should always use LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf
.gitignore text eol=lf
.prettierrc text eol=lf

# Windows-specific scripts should preserve CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary file types that should never be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.doc binary
*.docx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.node binary
