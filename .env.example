# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_PORT=5173
AI_SERVICE_PORT=8000

# Databases
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thinkwire_db
MONGODB_URI=mongodb://localhost:27017/thinkwire_db
REDIS_URL=redis://localhost:6379

# Auth & Security
JWT_SECRET=your_jwt_secret_min_32_chars_here
JWT_ADMIN_SECRET=your_jwt_admin_secret_min_32_chars_here
JWT_CANDIDATE_SECRET=your_jwt_candidate_secret_min_32_chars_here
ALLOWED_ORIGINS=https://thinkwires.vercel.app,http://localhost:5173
INITIAL_SUPERADMIN_EMAIL=admin@yourcompany.com
INITIAL_SUPERADMIN_PASSWORD=ConfigureAStrongRandomPassword16Chars!
ALLOW_PRODUCTION_SEED=false

# Storage
STORAGE_DRIVER=local
S3_BUCKET=thinkwires-storage
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_DOMAIN=

# AI Services
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your_secure_shared_ai_service_api_key_min_32_chars
PRIMARY_LLM_PROVIDER=auto
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Email
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@thinkwires.com
SMTP_PASS=your_smtp_password_here
EMAIL_FROM="ThinkWires" <info@thinkwires.com>
RECRUITMENT_NOTIFICATION_EMAIL=hr@thinkwires.com
ADMIN_NOTIFICATION_EMAIL=info@thinkwires.com
COMPANY_INFO_EMAIL=info@thinkwires.com
HR_REQUISITION_EMAIL=hr@thinkwires.com
OVERRIDE_NOTIFICATION_EMAIL=websiteadmin@thinkwires.com

# Frontend
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME=ThinkWires
VITE_APP_ENV=development
