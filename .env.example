# ==============================================================================
# ThinkWires Monorepo - Master Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' at the root or distribute keys to apps/*/.env:
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Do NOT commit real production passwords, secrets, or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ports and Application Server Bindings
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 2. Database Persistence (Dual-Mode: PostgreSQL + MongoDB)
# ------------------------------------------------------------------------------
# --- PostgreSQL Configurations (Choose ONE based on your environment) ---
# Option A: Local PostgreSQL (native installation, Docker, or pgAdmin)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thinkwire_db
#
# Option B: Neon Serverless PostgreSQL (Recommended for cloud/Vercel)
# DATABASE_URL=postgresql://<user>:<password>@ep-shiny-feather-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Option C: Supabase PostgreSQL (use port 6543 for transaction pooling or 5432 for direct)
# DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Option D: AWS RDS / Render / Azure Managed PostgreSQL
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>?sslmode=require
#
# Alternatively, specify individual parameters (auto-assembled if DATABASE_URL is omitted):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=thinkwire_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thinkwire_db

# Optional PostgreSQL Controls:
# DB_SSL=false              # Explicitly disable SSL (useful for local Postgres in production mode)
# DB_SSL=true               # Force SSL regardless of hostname
# DB_LOGGING=true           # Log all executed SQL queries to terminal (useful for local debugging)

# --- MongoDB Configurations (Choose ONE based on your environment) ---
# Option A: Local MongoDB / MongoDB Compass (default)
# MONGODB_URI=mongodb://localhost:27017/thinkwire_db
# (Or with authentication: mongodb://admin:secret@127.0.0.1:27017/thinkwire_db?authSource=admin)
#
# Option B: MongoDB Atlas (Cloud Cluster - Recommended for staging/production)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/thinkwires_prod?retryWrites=true&w=majority
#
# Active MongoDB URI:
MONGODB_URI=mongodb://localhost:27017/thinkwire_db

# Optional Redis Cache
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing JWT auth tokens and candidate session cookies
JWT_SECRET=your_jwt_secret_min_32_chars_here

# Allowed origins for CORS (comma-separated). Automatically accepts *.vercel.app in production.
ALLOWED_ORIGINS=https://thinkwires.vercel.app,http://localhost:5173

# Cookie SameSite attribute ('lax' for same-domain or Vercel rewrites, 'none' for cross-domain HTTPS)
COOKIE_SAME_SITE=lax

# Initial Superadmin credentials for fresh company database seeding ('npm run seed')
INITIAL_SUPERADMIN_EMAIL=superadmin@thinkwires.com
INITIAL_SUPERADMIN_PASSWORD=ThinkWires@Admin2026!

# ------------------------------------------------------------------------------
# 4. AI Services & LLM Integration (apps/ai_services)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. Recruitment Email Notifications (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=careers@thinkwires.com
SMTP_PASS=your_smtp_app_password_here
SMTP_SECURE=false
EMAIL_FROM="ThinkWires Recruitment" <careers@thinkwires.com>
RECRUITMENT_NOTIFICATION_EMAIL=recruitment@thinkwires.com
ADMIN_NOTIFICATION_EMAIL=admin@thinkwires.com
