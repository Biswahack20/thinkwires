# ==============================================================================
# ThinkWires Monorepo - Master Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' at the root or distribute keys to apps/*/.env:
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Do NOT commit real production passwords, secrets, or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ports and Application Server Bindings
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 2. Database Persistence (Dual-Mode: PostgreSQL + MongoDB Atlas)
# ------------------------------------------------------------------------------
# PostgreSQL (Relational persistence - Neon Serverless or Local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=thinkwire_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thinkwire_db

# MongoDB (Document persistence, ATS scores, CMS, Candidate records)
# Local instance default or Atlas URI (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/thinkwire_db)
MONGODB_URI=mongodb://localhost:27017/thinkwire_db

# Optional Redis Cache
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing JWT auth tokens and candidate session cookies
JWT_SECRET=your_jwt_secret_min_32_chars_here

# ------------------------------------------------------------------------------
# 4. AI Services & LLM Integration (apps/ai_services)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 5. Recruitment Email Notifications (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=careers@thinkwires.com
SMTP_PASS=your_smtp_app_password_here
SMTP_SECURE=false
EMAIL_FROM="ThinkWires Recruitment" <careers@thinkwires.com>
RECRUITMENT_NOTIFICATION_EMAIL=recruitment@thinkwires.com
ADMIN_NOTIFICATION_EMAIL=admin@thinkwires.com
